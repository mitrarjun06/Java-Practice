/* Tutorial 3 */
import java.util.Scanner;
public class Area
{
    int l,b;
    Area(int l, int b){
        this.l = l;
        this.b = b;
    }
    int calc(){
        int ar = l * b;
        return ar;
    }
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int a,b;
        System.out.println("Enter length");
        a = sc.nextInt();
        System.out.println("Enter breadth");
        b = sc.nextInt();
        Area m = new Area(a,b);
        System.out.println("Area is: " + m.calc());
    }
}
