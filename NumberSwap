/* Tutorial 4b */
import java.util.Scanner;
public class Exchange2
{
    public static void main(String[] args){
        int a,b;
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter first roll number");
        a = sc.nextInt();
        System.out.println("Enter second roll number");
        b = sc.nextInt();
        a = a + b;
        b = a - b;
        a = a - b;
        System.out.println("First roll number: " + a);
        System.out.println("Second roll number: " + b);
    }
}
